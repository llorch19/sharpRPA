<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>sharpRPA.Tests</RootNamespace>
    <AssemblyName>sharpRPA.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sharpRPA.Core\sharpRPA.Core.csproj" />
    <!-- referenced so contract helpers (envelope, cursor, error codes) can be unit tested;
         the integration test still spawns the built server as a separate process -->
    <ProjectReference Include="..\sharpRPA.Mcp\sharpRPA.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\sharpRPA\Script Sample Files\*.xml"
          Link="Samples\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
