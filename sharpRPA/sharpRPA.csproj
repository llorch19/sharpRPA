<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>sharpRPA</RootNamespace>
    <AssemblyName>sharpRPA</AssemblyName>
    <ApplicationIcon>rpalogo_RHA_icon.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <Version>0.0.9</Version>
    <FileVersion>0.0.9.0</FileVersion>
    <AssemblyVersion>0.0.9.0</AssemblyVersion>
    <Product>sharpRPA</Product>
    <Description>Build and Execute Automation Scripts</Description>
    <Copyright>Copyright © 2017</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sharpRPA.Core\sharpRPA.Core.csproj" />
    <ProjectReference Include="..\sharpRPA.Windows\sharpRPA.Windows.csproj" />
  </ItemGroup>

</Project>
